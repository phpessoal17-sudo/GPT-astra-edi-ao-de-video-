{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audiovisual Knowledge Entry",
  "type": "object",
  "required": ["id", "date", "module", "classification", "summary", "source", "status"],
  "properties": {
    "id": {"type": "string"},
    "date": {"type": "string", "format": "date"},
    "module": {"type": "string", "pattern": "^0[1-7]$"},
    "classification": {"enum": ["verificado", "preferencia", "hipotese", "experimento"]},
    "summary": {"type": "string"},
    "source": {"type": "string"},
    "evidence": {"type": ["string", "null"]},
    "status": {"enum": ["proposto", "testado", "aprovado", "reprovado", "substituido"]},
    "supersedes": {"type": ["string", "null"]}
  }
}

